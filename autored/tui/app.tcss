/* AutoRed TUI global CSS — Phase 3, Task 10 + Phase 6, Task 13. */

Screen {
    background: $background;
    color: $text;
}

#dashboard-body {
    height: 1fr;
    border: round $primary;
    background: $surface;
}

ActivityLog {
    height: 1fr;
    border: round $primary;
    background: $surface;
}

/* EngagementListScreen (Phase 6 Task 13, spec §17.5). */

EngagementListScreen {
    layout: vertical;
    padding: 0 1;
}

EngagementListScreen DataTable {
    height: 1fr;
    margin: 1 0;
}

/* EvidenceViewerScreen (Phase 6 Task 14, spec §17.5). */

EvidenceViewerScreen {
    layout: vertical;
}

EvidenceViewerScreen TabbedContent {
    height: 1fr;
}

/* LogViewerScreen (Phase 6 Task 14, spec §17.5). */

LogViewerScreen {
    layout: vertical;
}

LogViewerScreen RichLog {
    height: 1fr;
    border: solid $accent;
    margin: 0 1;
}

/* StateInspectorScreen (Phase 6 Task 15, spec §17.5). */

StateInspectorScreen {
    layout: vertical;
    padding: 0 1;
}

StateInspectorScreen Tree {
    height: 1fr;
    margin: 1 0;
}

/* FindingsTableScreen (Phase 6 Task 15, spec §17.5). */

FindingsTableScreen {
    layout: vertical;
    padding: 0 1;
}

FindingsTableScreen #filters {
    height: 3;
}

FindingsTableScreen DataTable {
    height: 1fr;
}

/* AttackGraphScreen (Phase 6 Task 16, spec §17.5). */

AttackGraphScreen {
    layout: vertical;
    padding: 0 1;
}

AttackGraphScreen Tree {
    height: 1fr;
    margin: 1 0;
}

/* RoEEditorScreen (Phase 6 Task 17, spec §17.5). */

RoEEditorScreen {
    layout: vertical;
    padding: 0 1;
}

RoEEditorScreen TextArea {
    height: 1fr;
    margin: 1 0;
}

RoEEditorScreen #validation-status {
    height: auto;
    max-height: 8;
    margin: 0 0 1 0;
}
